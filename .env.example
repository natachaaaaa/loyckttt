# ==================================================================================================
#  LOYCK — configuration
#
#  Copier ce fichier en .env, puis remplir les valeurs marquées « À REMPLIR ».
#  Tout est facultatif : un champ vide = le site tourne quand même (contenu embarqué, créneaux de démo).
#  Après un changement : docker-compose up -d --build web   (les VITE_* sont figées dans le build)
#
#  Les commentaires sont toujours sur leur propre ligne : un « # » en bout de ligne ferait partie de la valeur.
# ==================================================================================================


# --------------------------------------------------------------------------------------------------
#  1. STORYBLOK — gestion du contenu                              (README > « Contenu : Storyblok »)
# --------------------------------------------------------------------------------------------------

# À REMPLIR — Token « Preview » : Paramètres de l'espace > Access tokens.
# Public (lecture seule) : il finit dans le code du site.
VITE_STORYBLOK_TOKEN=

# Région choisie à la création de l'espace : eu, us, ap ou ca.
VITE_STORYBLOK_REGION=eu

# --- Pour le script de préconfiguration uniquement, jamais envoyés au site. SECRETS. ---

# À REMPLIR — Paramètres de l'espace > Général > Space ID.
STORYBLOK_SPACE_ID=

# À REMPLIR — Mon compte (avatar en bas à gauche) > Personal access tokens > Generate new token.
STORYBLOK_PAT=

# Même valeur que VITE_STORYBLOK_REGION.
STORYBLOK_REGION=eu

# Adresse ouverte par l'éditeur visuel de Storyblok (https obligatoire).
SITE_URL=https://localhost:5173/


# --------------------------------------------------------------------------------------------------
#  2. PRISE DE RENDEZ-VOUS                                      (README > « Prise de rendez-vous »)
#     Public : ces valeurs finissent dans le code du site.
# --------------------------------------------------------------------------------------------------

# À REMPLIR — Google Agenda des RDV pris (partagé publiquement en « disponible/occupé uniquement »).
# Paramètres de l'agenda > Intégrer l'agenda > ID de l'agenda.
VITE_GCAL_ID=

# À REMPLIR — Clé API Google avec « Google Calendar API » activée, restreinte au domaine du site.
VITE_GCAL_KEY=

# À REMPLIR — Clé Web3Forms (gratuit, web3forms.com) : les demandes arrivent par email.
# Vide = le bouton ouvre l'application mail du visiteur.
VITE_WEB3FORMS_KEY=

# Email de secours (celui saisi dans Storyblok, section « Prise de rendez-vous », a la priorité).
VITE_CONTACT_EMAIL=


# --------------------------------------------------------------------------------------------------
#  3. DOCKER — ports sur ta machine
# --------------------------------------------------------------------------------------------------

# Site de production : http://localhost:8088
WEB_PORT=8088

# Développement (https, éditeur visuel) : https://localhost:5173
DEV_PORT=5173
